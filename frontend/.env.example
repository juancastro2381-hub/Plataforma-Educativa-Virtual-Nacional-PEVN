# ============================================================
# PEVN Frontend — Environment Configuration Example
# ============================================================
# Copy to .env.local for local development overrides.
# Variables prefixed with VITE_ are bundled into the frontend
# and visible in the browser — NEVER put secrets here.
# ============================================================

# API base URL — the backend service
VITE_API_BASE_URL=http://localhost:8000

# Application version (injected at build time)
VITE_APP_VERSION=0.1.0

# Application name
VITE_APP_NAME=Plataforma Educativa Virtual Nacional

# Environment name (for conditional behavior, NOT for secrets)
VITE_APP_ENV=development

# API timeout in milliseconds
VITE_API_TIMEOUT_MS=30000
