# ============================================================
# PEVN — Environment Configuration Template
# ============================================================
# Copy this file to .env and replace ALL placeholder values.
# NEVER commit the .env file to version control.
# The .gitignore already excludes .env from commits.
#
# SECURITY RULES:
#   1. Never use real passwords or secrets in this file.
#   2. Never commit .env to git (it's in .gitignore).
#   3. In production, use a secret management system.
#   4. Run ./infrastructure/scripts/check_env.sh to validate.
# ============================================================

# ---- Application --------------------------------------------------
ENVIRONMENT=development
# Options: development | staging | production
# SECURITY: Set to 'production' only with all production settings confirmed.

DEBUG=true
# SECURITY: Must be 'false' in production.

LOG_LEVEL=INFO
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL

LOG_FORMAT=console
# Options: console (development) | json (production/staging)

# ---- Cryptographic Secret -----------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# SECURITY: Must be at least 128 hex characters. Never reuse across environments.
SECRET_KEY=REPLACE_ME_WITH_A_MINIMUM_128_CHARACTER_RANDOM_HEX_STRING

# ---- Database — PostgreSQL ----------------------------------------
POSTGRES_DB=pevn_db
POSTGRES_USER=pevn_admin
POSTGRES_PASSWORD=REPLACE_ME_POSTGRES_ADMIN_PASSWORD

# Application user (least privilege — used by the running app)
POSTGRES_APP_USER=pevn_app
POSTGRES_APP_PASSWORD=REPLACE_ME_POSTGRES_APP_PASSWORD

# Full connection string for the backend (uses the app user)
DATABASE_URL=postgresql+asyncpg://pevn_app:REPLACE_ME_POSTGRES_APP_PASSWORD@db:5432/pevn_db

# ---- Redis --------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Production: redis://:<password>@<host>:<port>/<db>

# ---- Security / CORS ----------------------------------------------
# Comma-separated list of allowed browser origins.
# SECURITY: Never use '*' in staging or production.
CORS_ORIGINS=http://localhost:3000

# Comma-separated list of allowed Host header values.
# SECURITY: Set exactly to your domain in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- API ----------------------------------------------------------
API_V1_PREFIX=/api/v1

# ---- Virtual Classroom / BigBlueButton -----------------------------
MEETING_PROVIDER_TYPE=mock
# Options: mock (local development/tests) | bbb (staging/production)
BBB_API_URL=https://bbb-staging.pevn.gov.co/bigbluebutton/api
BBB_SHARED_SECRET=REPLACE_ME_WITH_BIGBLUEBUTTON_SECURITY_SALT
BBB_SIGNING_ALGORITHM=sha256
# Options: sha1 | sha256
BBB_TIMEOUT_SECONDS=10.0

# ---- Frontend (Vite) Variables ------------------------------------
# These are bundled into the JavaScript and visible to all users.
# NEVER put secrets here.
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_VERSION=0.1.0
VITE_APP_ENV=development
VITE_API_TIMEOUT_MS=30000

